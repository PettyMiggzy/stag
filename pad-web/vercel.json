{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "stag-pad.vercel.app"
        }
      ],
      "destination": "https://www.stagwifhood.fun/:path*",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/browse.html",
      "destination": "/explore",
      "permanent": true
    },
    {
      "source": "/create.html",
      "destination": "/create",
      "permanent": true
    },
    {
      "source": "/docs.html",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    }
  ]
}