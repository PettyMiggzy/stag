{
  "removedFromPadHook": [
    "import {TransientStateLibrary} from \"@uniswap/v4-core/src/libraries/TransientStateLibrary.sol\";",
    "interface IPadToken {",
    "function burn(uint256 amount) external;",
    "function sync() external returns (uint256);",
    "}",
    "contract PadHook is BaseHook {",
    "using TransientStateLibrary for IPoolManager;",
    "Info storage i = info[key.toId()];",
    "_flush(id, i);",
    "i.holderOwed += (fee - c).toUint128();",
    "bytes32 slot = PoolId.unwrap(id);",
    "assembly { tstore(slot, 1) }",
    "function pushHolders(PoolKey calldata key) external {",
    "PoolId id = key.toId();",
    "Info storage i = info[id];",
    "uint256 a = i.holderOwed;",
    "if (a == 0) revert NothingToDo();",
    "i.holderOwed = 0;",
    "_redeem(i.token, a);",
    "try IPadToken(i.token).sync() {} catch {}",
    "}",
    "function _flush(PoolId id, Info storage i) internal {",
    "uint256 a = i.holderOwed;",
    "if (a == 0) return;",
    "bytes32 slot = PoolId.unwrap(id);",
    "uint256 booked;",
    "assembly { booked := tload(slot) }",
    "if (booked != 0) return;",
    "if (Currency.unwrap(poolManager.getSyncedCurrency()) == QUOTE) return;",
    "i.holderOwed = 0;",
    "poolManager.burn(address(this), _qid(), a);",
    "poolManager.take(Currency.wrap(QUOTE), i.token, a);",
    "try IPadToken(i.token).sync() {} catch {}",
    "}",
    "poolManager.take(Currency.wrap(token), address(this), got);",
    "IPadToken(token).burn(got);"
  ],
  "addedInOpenHook": [
    "contract OpenHook is BaseHook {",
    "address public constant DEAD = 0x000000000000000000000000000000000000dEaD;",
    "mapping(PoolId => bool) public barred;",
    "event BarredSet(PoolId indexed id, bool barred);",
    "error Barred();",
    "function setBarred(PoolId id, bool b) external onlyOwner {",
    "barred[id] = b;",
    "emit BarredSet(id, b);",
    "}",
    "PoolId id = key.toId();",
    "if (l && barred[id]) revert Barred();",
    "Info storage i = info[id];",
    "i.chest += (fee - c).toUint128();",
    "poolManager.take(Currency.wrap(token), DEAD, got);"
  ]
}
