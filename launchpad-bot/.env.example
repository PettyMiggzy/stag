# ============================================================
#  $STAG — Buy Bot  ·  copy to .env and fill in
#  Robinhood Chain (EVM, chainId 4663). Read-only, no keys.
# ============================================================

# ---- WHICH COIN TO WATCH (required) -------------------------
# The NEW $STAG token contract + its liquidity pool.
TOKEN_ADDRESS=0x67Ef4460A1280fBD9d31D6312FEd2Ce1EFd66305
POOL_ADDRESS=0x8e68043f7553ff7adf30eb8b0baac8d8fc2ed958
WETH_ADDRESS=0x0bd7d308f8e1639fab988df18a8011f41eacad73

# Optional labels — leave blank to read name/symbol on-chain
NAME=StagWifHood
TICKER=STAG

# ---- WHERE TO POST (set Telegram, Discord, or both) --------
# Telegram: @BotFather -> /newbot -> token; add the bot to the group as ADMIN.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # group id looks like -1001234567890

# Discord: Server Settings -> Integrations -> Webhooks -> Copy URL
DISCORD_WEBHOOK_URL=

# ---- CHAIN (defaults already correct for Robinhood Chain) --
RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
RPC_WS=                                                     # optional websocket RPC
EXPLORER=https://robinhoodchain.blockscout.com
# Buy/chart link shown on each alert — the token's page on $STAG.
# Final link becomes:  <LAUNCHPAD_URL>/<TOKEN_ADDRESS>
LAUNCHPAD_URL=https://robinhoodchain.blockscout.com/token

# ---- ALERT TUNING (all optional) ---------------------------
MIN_BUY_ETH=0             # hide dust buys below this ETH amount
ETH_USD=                  # static ETH price to show $ + market cap (blank = ETH-only)
EMOJI_STEP_ETH=0.02       # one 🟩 per this much ETH
BUY_EMOJI=🟩
MEDIA_URL=                # image/gif shown on each alert
POLL_MS=8000              # how often to check for new blocks (min 3000)
START_BLOCK=0             # 0 = start from now, don't replay old buys
