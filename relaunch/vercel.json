{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/pad",
   "destination": "https://stag-pad.vercel.app",
   "permanent": false
  },
  {
   "source": "/pad/:path*",
   "destination": "https://stag-pad.vercel.app",
   "permanent": false
  }
 ]
}